# ============================================
# ES-VERT · Variables de entorno
# ============================================
#
# Hay DOS modos (GitHub Pages es hosting estático: todo lo VITE_* acaba
# empotrado en el JS público).
#
# MODO A · USO PERSONAL  (la clave se incrusta en el bundle):
#   1) Crea tu clave en https://platform.minimax.io (API Keys).
#   2) Cópiala AQUÍ para desarrollo local (NUNCA la subas al repo):
#
VITE_MINIMAX_API_KEY="tu-api-key-de-minimax"
#
#   Para GitHub Pages: añade en el repo → Settings → Secrets and
#   variables → Actions → New repository secret: VITE_MINIMAX_API_KEY
#
# MODO B · APP PÚBLICA  (vía proxy serverless, recomendado):
#   La key real vive solo en el Worker (ver ai-proxy/worker.js). En este
#   archivo y como secret de CI solo pones la URL pública del Worker:
#
# VITE_AI_PROXY_URL="https://tu-worker.tu-subdominio.workers.dev"
# VITE_AI_PROXY_TOKEN="token-compartido-opcional"
#
# Opcionales (defaults razonables ya incluidos en el código):
#
# VITE_MINIMAX_BASE_URL="https://api.minimax.io/v1"
# VITE_MINIMAX_MODEL="MiniMax-M2"
#
# ---- Generación de imágenes ----------------------------------------
#
# Imagen real con TU foto (image-to-image). Es la ÚNICA opción
# browser-direct que de verdad transforma tu foto:
#
# A · REPLICATE (recomendado, $5 gratis al registrarse)
#     - https://replicate.com (Google login, ~30 s, sin tarjeta)
#     - https://replicate.com/account/api-tokens → Create token
#     - CORS habilitado, funciona desde el navegador
#     - SDXL hace img2img: tu foto entra como conditioning
#
VITE_REPLICATE_API_TOKEN="r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_REPLICATE_MODEL="stability-ai/sdxl"
# Opcionales:
# VITE_REPLICATE_VERSION="hash-de-version-concreto"   (si "model" no funciona)
# VITE_REPLICATE_STRENGTH="0.65"
#
# B · TOGETHER.AI  (T2I — NO usa tu foto, solo prompt)
#     - https://api.together.xyz (Google, $5 free)
#     - Settings → API Keys
#
# VITE_TOGETHER_API_KEY="tgp_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# VITE_TOGETHER_MODEL="black-forest-labs/FLUX.1-schnell-Free"
#
# C · HUGGINGFACE (img2img, requiere proxy Worker por CORS)
#     - https://huggingface.co/settings/tokens (Read o Write)
#     - Solo funciona con VITE_AI_PROXY_URL activo (modo B arriba)
#
# VITE_HUGGINGFACE_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxx"
# VITE_HUGGINGFACE_MODEL="stabilityai/stable-diffusion-xl-base-1.0"
#
# D · CUSTOM  (Replicate / fal.ai / Stability, otros)
#
# VITE_IMAGE_API_URL="https://api.replicate.com/v1/predictions"
# VITE_IMAGE_API_KEY="tu-api-key"
# VITE_IMAGE_MODEL="stability-ai/sdxl"
#
# Si TODO falla, la app usa un stock curado de Picsum (sigue
# funcionando, pero la imagen no tendrá relación con tu foto).
